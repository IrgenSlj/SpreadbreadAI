{
  "name": "@spreadbreadai/mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for workbook and canvas tools",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --watch --import tsx src/index.ts",
    "start:http": "node --import tsx src/http-main.ts",
    "dev:http": "node --watch --import tsx src/http-main.ts",
    "db:init": "node --import tsx src/db-init.ts",
    "db:import": "node --import tsx src/db-import.ts",
    "health": "node --import tsx src/health.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx src/health.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
