{
  "name": "spreadbreadai",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, human-in-the-loop spreadsheet operations platform",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev:web": "pnpm --filter @spreadbreadai/web dev",
    "dev:mcp": "pnpm --filter @spreadbreadai/mcp-server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @spreadbreadai/web typecheck && pnpm --filter @spreadbreadai/mcp-server build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
